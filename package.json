{
  "name": "@substratum-labs/kadmos",
  "version": "0.1.1",
  "description": "Constitutional state machines, verified runtime gatekeepers, and counterexample-guided self-healing for neuro-symbolic coding agents",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/substratum-labs/kadmos.git"
  },
  "homepage": "https://github.com/substratum-labs/kadmos#readme",
  "bugs": {
    "url": "https://github.com/substratum-labs/kadmos/issues"
  },
  "author": "Substratum Labs",
  "keywords": [
    "agent",
    "ai",
    "neuro-symbolic",
    "formal-verification",
    "state-machine",
    "mcp",
    "cegis",
    "guardrails",
    "gatekeeper"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "kadmos": "./bin/kadmos.js",
    "kadmos-mcp": "./bin/kadmos-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./adapters/bullmq": {
      "types": "./dist/src/adapters/bullmq/index.d.ts",
      "default": "./dist/src/adapters/bullmq/index.js"
    }
  },
  "files": [
    "bin",
    "dist/src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --eval \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "test": "pnpm run build && node scripts/run-tests.js",
    "test:fuzz": "pnpm run build && node bin/kadmos.js test conformance/fixtures/order_settlement.world.yaml --runs 30",
    "prepack": "pnpm run build",
    "demo": "pnpm run build && node dist/examples/order_fabric_demo.js",
    "demo:circuit": "pnpm run build && node dist/examples/circuit-breaker-worker/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm run test && pnpm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "bullmq": "^6.3.9",
    "ioredis": "^6.0.0",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  }
}
